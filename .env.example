# Copie este arquivo para .env e preencha com os dados reais.

# Banco e desempenho em ambiente serverless (Vercel + Supabase)
# Use em DATABASE_URL a URL do Transaction Pooler do Supabase (porta 6543).
DATABASE_URL=
DATABASE_POOL_MODE=transaction
DATABASE_CONN_MAX_AGE=0
CRM_ACCESS_PING_SECONDS=300

# WhatsApp Cloud API / Meta
WHATSAPP_SEND_MODE=web
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0

# SMTP para envio por e-mail
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Para testar sem enviar e-mail real, use:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
