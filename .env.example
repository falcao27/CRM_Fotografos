# Copie este arquivo para .env e preencha com os dados reais.
# O .env nunca deve ser enviado ao GitHub.

# Django
# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
# Use True apenas no ambiente local.
DEBUG=True
# Dominios extras separados por virgula (localhost e 127.0.0.1 ja sao aceitos).
ALLOWED_HOSTS=
# Origens com https:// separadas por virgula, ex.: https://seu-dominio.com
CSRF_TRUSTED_ORIGINS=

# Banco e desempenho em ambiente serverless (Vercel + Supabase)
# Use em DATABASE_URL a URL do Transaction Pooler do Supabase (porta 6543).
# Deixe vazio para usar SQLite no ambiente local.
DATABASE_URL=
DATABASE_POOL_MODE=transaction
DATABASE_CONN_MAX_AGE=60
CRM_ACCESS_PING_SECONDS=300

# Supabase Storage (contratos assinados e anexos)
# Sem SUPABASE_URL e SUPABASE_SECRET_KEY os arquivos ficam na pasta media/ local.
USE_SUPABASE_STORAGE=1
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=crm-media

# Login com Google (opcional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# E-mail do administrador da plataforma (painel admin master)
CRM_MASTER_ADMIN_EMAIL=

# WhatsApp Cloud API / Meta
WHATSAPP_SEND_MODE=web
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0

# SMTP para envio por e-mail
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Para testar sem enviar e-mail real, use:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
